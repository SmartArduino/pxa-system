{
  "schema": "pxa-clock-spec-0.3",
  "status": "draft",
  "service": {
    "name": "clock",
    "id": 4,
    "major": 0,
    "minor": 3,
    "patch": 0
  },
  "opcodes": [
    {
      "name": "set-period",
      "id": 1,
      "direction": "guest-to-host",
      "request_token": "zero",
      "payload": "period-ms:u16",
      "constraint": "zero-or-16-through-1000"
    },
    {
      "name": "now",
      "id": 2,
      "direction": "guest-to-host",
      "request_token": "nonzero",
      "payload": "empty"
    },
    {
      "name": "tick",
      "id": 32769,
      "direction": "host-to-guest",
      "request_token": "zero",
      "payload": "monotonic-us:u64",
      "delivery": "coalescible"
    },
    {
      "name": "now-result",
      "id": 32770,
      "direction": "host-to-guest",
      "request_token": "echo",
      "payload": "status:i32,monotonic-us:u64"
    },
    {
      "name": "wall-time",
      "id": 3,
      "direction": "guest-to-host",
      "request_token": "nonzero",
      "payload": "empty",
      "completion": "status:i32,unix-us:i64,monotonic-us:u64,utc-offset-seconds:i32,flags:u32",
      "semantics": "Core 1/2 reserved completion; effective Host zone at the sampled instant; flags bit 0 is daylight saving; all other bits zero"
    },
    {
      "name": "limits",
      "id": 4,
      "direction": "guest-to-host",
      "request_token": "nonzero",
      "payload": "empty",
      "completion": "status:i32,min-period-us:u32,max-period-us:u32,period-step-us:u32,dispatch-quantum-us:u32,flags:u32"
    },
    {
      "name": "configure",
      "id": 5,
      "direction": "guest-to-host",
      "request_token": "nonzero",
      "payload": "period-us:u32",
      "completion": "status:i32,accepted-period-us:u32",
      "constraint": "zero-cancels; otherwise within advertised limits and a multiple of period-step-us; no rounding; failure preserves current timer"
    }
  ],
  "protocol_version": "0.3.0",
  "features": [
    {
      "name": "timing",
      "bit": 0
    }
  ]
}
