  "root_info": {
    "bytes": 72,
    "fields": "volume-id:16|mount-epoch:u64|rights:u32|capabilities:u64|max-path:u16|max-segment:u16|max-read-at:u32|naming:u8|state:u8|space-known:u16|total:u64|free:u64|quota:u64",
    "space_known": "bit0 total, bit1 free, bit2 quota; zero means unknown",
    "naming": "1 byte-exact; 2 native case-insensitive",
    "capabilities": "bit 0 READ_AT; max-read-at is 4096 only for positional-read providers"
  },
  "roots_rules": [
    "Core 2 only; old operations 1..8 unchanged",
    "Directory uses Core DIRECTORY type 4; files use FILE type 3",
    "User grant operations require an exact fs.user-directory read or read-write Permission authority",
    "Rights read=1/enumerate=2/write=4/create=8/remove=16; backend may support only read|enumerate",
    "Root kind grant=4 requires Permission and GrantId; app-media=5 requires feature bit6 and zero Permission/GrantId; private/cache/temp roots remain unsupported in initial profile",
    "Session-only picker returns zero GrantId; persistent picker returns Host opaque 16-byte GrantId",
    "New paths are UTF-8, no NUL/absolute/dot/parent/backslash/colon/trailing-dot/trailing-space or case variants of .pxa-* segments; backend reports path limits",
    "Initial adapter uses existing sequential FILE read and FS seek; no new I/O opcode advertised",
    "72-byte root-info and 28-byte open-at success data exclude the Core status field",
    "Revocation and component stop close authority-bound descendants; cancelled pickers cannot publish a result",
    "App media roots are bound to the verified app identity and explicit Host storage policy; no picker, no arbitrary path and no fallback to another volume. Initial ESP profile is read-only."
  ],
  "file_io": {
    "read_at": {
      "operation": 16,
      "header_bytes": 24,
      "fields": "offset:u64|cookie:u64|requested:u32|reserved:u32=0|data:bytes[requested]",
      "max_bytes": 4096,
      "return": "actual data bytes, zero at EOF, or negative status",
      "cookie": "strictly increasing, nonzero per FILE; success/error retire cookie; invalid headers do not; reused retired cookie is cancelled",
      "cursor": "unchanged",
      "provider": "bounded synchronous; no retained Guest pointer, no WOULD_BLOCK, no worker or pending lane advertised"
    },
    "cancel_read_at": {
      "operation": 17,
      "fields": "cookie:u64",
      "return": "0; idempotently retire cookies up to this value; reject zero",
      "inflight": "current synchronous profile has no pending operation"
    },
    "file_features": {
      "read-at": 0
    }
  }
