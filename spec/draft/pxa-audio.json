      "result": "status",
      "since": "0.2"
    },
    {
      "name": "open-pcm",
      "id": 5,
      "direction": "bidirectional-result",
      "request_token": "nonzero",
      "since": "0.10",
      "payload": "permission-handle:u64|source-rate:u32|source-channels:u8|reserved:3*u8",
      "result": "status|session-handle|source-format|sink-rate|sink-channels|queue-source-frames"
    }
  ],
  "resource_io": [
    {
      "name": "play-tone",
      "id": 256,
