      "since": "0.4"
    },
    {
      "name": "control-asset",
      "id": 258,
      "payload": "action:u8|reserved:u8|gain-db-q8:i16",
      "result": "payload-size-or-status",
      "since": "0.4"
    },
    {
      "name": "play-sound",
      "id": 259,
      "payload": "asset-handle:u64|gain-db-q8:i16|reserved:2*u8",
      "result": "payload-size-or-status",
      "since": "0.6",
      "extended_payload": "asset-handle:u64|gain-db-q8:i16|track:u8|loop:u8|reserved:4*u8",
      "extended_since": "0.8"
    },
    {
      "name": "play-music",
      "id": 260,
      "payload": "instance-out:u64|path-size:u16|gain-db-q8:i16|flags:u8|reserved:3*u8|package-path:bytes",
      "result": "payload-size-or-status; accepted command writes nonzero instance",
      "since": "0.7"
    },
    {
      "name": "control-sound",
      "id": 261,
      "payload": "track:u8|action:u8|gain-db-q8:i16|reserved:4*u8",
      "result": "payload-size-or-status",
      "since": "0.8"
    },
    {
      "name": "control-music",
      "id": 262,
      "payload": "action:u8|reserved:u8|gain-db-q8:i16",
      "result": "payload-size-or-status",
      "since": "0.8"
    },
    {
      "name": "play-effect",
      "id": 263,
      "since": "0.9",
      "payload": "layer-count:u8|track:u8|reserved:u16|tone[14]*",
      "semantics": "1..8 layers on a common sample clock, atomic replacement for tracks 0..5, independent at 255; WOULD_BLOCK accepts no layers and queues no event",
      "result": "payload-size-or-status"
    },
    {
      "name": "stop-effect",
      "id": 264,
      "since": "0.9",
      "payload": "track:u8|reserved:24",
      "semantics": "idempotent stop for a synthesized effect track, separate from resident sound tracks",
      "result": "payload-size-or-status"
    },
    {
      "name": "mix-pcm",
      "id": 265,
      "since": "0.11",
      "payload": "target-offset:u32|target-frames:u32|spans-offset:u32|span-count:u16|reserved:u16",
      "result": "16-or-status; atomic validation, synchronous S32LE stereo accumulation"
    }
  ],
