  "limits": {
    "max_sessions_per_component": 1,
    "max_eq_bands": 5,
    "min_sample_rate": 8000,
    "max_sample_rate": 48000,
    "min_frame_ms": 5,
    "max_frame_ms": 120
  },
  "protocol_version": "0.11.0",
  "playback_event": {
    "id": 32769,
    "since": "0.7",
    "request_token": "zero",
    "payload": "session-handle:u64|instance:u64|state:u8|reserved:3*u8|status:i32",
    "states": {
      "ready": 1,
      "ended": 2,
      "stopped": 3,
      "replaced": 4,
      "error": 5
    },
    "delivery": "reliable; retain until queued; bounded admission"
  },
  "effect_groups": {
    "max_layers": 8,
    "track_count": 6,
    "independent_track": 255,
    "header_bytes": 4,
    "tone_bytes": 14,
    "stop_bytes": 4,
    "scope": "session; separate from prepared sound tracks",
    "capacity": "track_count names replacement categories; simultaneous admission is determined by available shared slots"
  },
  "sound_tracks": {
    "count": 6,
    "scope": "session",
    "replacement": "atomically replace the previous sound on the same track; retain the new asset before retiring the old pin",
    "timing": "Host sampling clock, independent of Guest ticks",
    "controls": "pause, resume, faded stop, gain ramp",
    "legacy": "12-byte play-sound appends an untracked one-shot; control-asset still controls all sounds and music",
    "music": "control-music affects streamed music only"
  },
  "pcm_sessions": {
    "since": "0.10",
    "wire_profile": 1,
    "request_bytes": 16,
    "result_bytes": 56,
    "sample_format": "interleaved signed 16-bit little endian",
    "source_rate": "8000..48000 Hz, exact or UNSUPPORTED; never implicit fallback",
    "source_channels": "1 or 2, exact",
    "max_packet_frames": "floor(source_rate * 20 / 1000)",
    "queue_frames": "bounded maximum in source frames; 1..floor(source_rate * 120 / 1000)",
    "sink_format": "reported physical route; stereo source can be mixed to a mono speaker by the Host",
    "state_counters": "source sample frames, independent of channels; accepted means renderer consumption unless flags specify sink-submitted",
    "operations": "WRITE, MIX_PCM (since 0.11), commit-graph, query-state, flush and close; other resource I/O returns UNSUPPORTED",
    "permission": "audio.playback media; authority, quotas and close rules match open-session",
    "reserved": "all request reserved bytes must be zero; unknown flags rejected"
  },
  "mix_pcm": {
    "header_bytes": 16,
    "span_bytes": 32,
    "max_spans": 32,
    "max_frames": 4096,
    "max_work": 16384,
    "span": "source-offset:u32|source-bytes:u32|position-q16:u32|step-q16:u32|target-first:u32|frames:u32|left-gain-q8:u16|right-gain-q8:u16|encoding:u8|channels:u8|reserved:u16",
    "encodings": {
      "s8": 1,
      "u8": 2,
      "s16le": 3
    },
    "channels": [
      1,
      2
    ],
    "gain": "0..256, unity 256; expand 8-bit to signed 16-bit then multiply and divide by 256 toward zero",
    "position": "unsigned Q16 source-frame position; nearest neighbour; step 1..1048576; last position must fit u32",
    "result": "add into existing interleaved S32LE stereo; saturate S32 in span order; no clearing or final PCM quantization",
    "ownership": "serialized wasm32 memory borrow for this synchronous call only; no retained pointers, copies, playback scheduling or extra task",
    "validation": "all spans before all writes; entire target must be disjoint from header, descriptors and each declared source range; BAD_STATE without a serialized borrowed-memory dispatch",
    "limits": "sum of span frames <= max_work; unknown/reserved fields rejected; no heap allocation"
  }
}
