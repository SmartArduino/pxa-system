      "name": "asset-bindings",
      "bit": 0
    }
  ],
  "create_flags": [
    {
      "name": "prefer-direct-scanout",
      "bit": 0
    },
    {
      "name": "borrow-commands",
      "bit": 1,
      "semantics": "Submit validates and rasterizes borrowed bytes synchronously. Never retains the input pointer. WOULD_BLOCK consumes no frame ID; retry after framebuffer progress. Host may reject unsupported mode at creation. Display remains asynchronous."
    }
