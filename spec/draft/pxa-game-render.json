  "opcodes": [
    {
      "name": "create-context",
      "id": 1,
      "direction": "bidirectional-result",
      "request_token": "nonzero",
      "payload": "width:u16|height:u16|buffer-count:u8|flags:u8|reserved:u8|scratch-mode:u8[|max-draw-bytes:u32]",
      "result": "handle:u64|capabilities:u32|max-draw-bytes:u32|max-texture-dimension:u16|max-textures:u8|reserved:u8"
    },
    {
      "name": "create-auto-context",
      "id": 2,
      "direction": "bidirectional-result",
      "request_token": "nonzero",
      "payload": "width:0|height:0|buffer-count:u8|flags:u8|requested-scale:u8|scratch-mode:u8[|max-draw-bytes:u32]",
      "result": "handle:u64|capabilities:u32|max-draw-bytes:u32|max-texture-dimension:u16|max-textures:u8|reserved:u8|display-width:u16|display-height:u16|render-width:u16|render-height:u16|render-scale:u8|supported-scale-mask:u8|reserved:[2]"
    }
  ],
  "io_operations": [
    {
      "name": "upload",
      "id": 256,
      "payload": "resource-record",
      "result": "accepted-bytes"
    },
    {
      "name": "submit",
      "id": 257,
      "payload": "draw-list",
      "result": "accepted-bytes"
    },
    {
      "name": "telemetry",
      "id": 258,
