{
  "schema": "pxa-game-render-spec-1.3",
  "status": "draft",
  "service": {
    "name": "game-render",
    "id": 18,
    "major": 1,
    "minor": 3,
    "patch": 0
  },
  "opcodes": [
    {
      "name": "create-context",
      "id": 1,
      "direction": "bidirectional-result",
      "request_token": "nonzero",
      "payload": "width:u16|height:u16|buffer-count:u8|flags:u8|reserved:u8|scratch-mode:u8[|max-draw-bytes:u32]",
      "result": "handle:u64|capabilities:u32|max-draw-bytes:u32|max-texture-dimension:u16|max-textures:u8|reserved:u8"
    },
    {
      "name": "create-auto-context",
      "id": 2,
      "direction": "bidirectional-result",
      "request_token": "nonzero",
      "payload": "width:0|height:0|buffer-count:u8|flags:u8|requested-scale:u8|scratch-mode:u8[|max-draw-bytes:u32]",
      "result": "handle:u64|capabilities:u32|max-draw-bytes:u32|max-texture-dimension:u16|max-textures:u8|reserved:u8|display-width:u16|display-height:u16|render-width:u16|render-height:u16|render-scale:u8|supported-scale-mask:u8|reserved:[2]"
    },
    {
      "name": "create-raster-context",
      "id": 3,
      "direction": "bidirectional-result",
      "request_token": "nonzero",
      "payload": "max-spans:u32|reserved:u32",
      "result": "handle:u64|max-spans:u32|reserved:u32",
      "semantics": "Compute-only context: no display, framebuffer, texture copies or scratch allocation."
    }
  ],
  "io_operations": [
    {
      "name": "upload",
      "id": 256,
      "payload": "resource-record",
      "result": "accepted-bytes"
    },
    {
      "name": "submit",
      "id": 257,
      "payload": "draw-list",
      "result": "accepted-bytes"
    },
    {
      "name": "telemetry",
      "id": 258,
      "payload": "zeroed-telemetry-buffer",
      "result": "telemetry-record"
    },
    {
      "name": "bind-assets",
      "id": 259,
      "payload": "count:u16|reserved:u16|entries[count]:(kind:u8|slot:u8|reserved:u16|handle:u64)",
      "result": "accepted-bytes",
      "atomic": true
    },
    {
      "name": "execute-spans",
      "id": 260,
      "payload": "spans-header|span[count]",
      "result": "accepted-bytes",
      "semantics": "Synchronous; prevalidate complete batch, borrow memory only until return. No pixels written on validation error."
    },
    {
      "name": "span-telemetry",
      "id": 261,
      "payload": "zeroed-64-byte-buffer",
      "result": "batches:u64|rejected:u64|spans:u64|pixels:u64|validation-us:u64|execute-us:u64|last-validation-us:u32|last-execute-us:u32|max-spans:u32|reserved:u32"
    },
    {
      "name": "execute-projected-spans",
      "id": 262,
      "payload": "spans-header|projection|scanline[count]",
      "result": "accepted-bytes",
      "semantics": "Synchronous strict f32 projection, indexed lighting and optional inverse-depth writes; preflight complete batch before writes."
    },
    {
      "name": "execute-frame-spans",
      "id": 263,
      "payload": "frame-header|materials|source-snapshots",
      "result": "accepted-bytes",
      "semantics": "Atomic multi-material indexed projection. Sources are packet-relative snapshots; target/depth are Guest linear offsets. Synchronous borrowed execution."
    },
    {
      "name": "blit-indexed-frame",
      "id": 264,
      "payload": "64-byte indexed-blit descriptor",
      "result": "accepted-bytes",
      "semantics": "Borrow INDEX8 image, RGB565LE palette, optional transparent-zero cursor and RGB565LE target. Preserve the legacy 320x240 logical sampling grid; no display allocation or present."
    },
    {
      "name": "blit-indexed-rect",
      "id": 265,
      "payload": "64-byte indexed-blit descriptor",
      "result": "accepted-bytes",
      "semantics": "Synchronous borrowed INDEX8-to-RGB565LE rectangle. Exact nearest-neighbour sampling sx=floor(x*source-width/target-width), sy=floor(y*source-height/target-height), including 1:1. Same validation and transparent-zero cursor as 0x108; target offset/pitch allow a subrectangle. No writes on validation failure, no retained pointers. Disjoint target byte ranges may run concurrently and must join before return. The legacy 0x108 sampling is unchanged."
    }
  ],
  "features": [
    {
      "name": "asset-bindings",
      "bit": 0
    },
    {
      "name": "borrowed-indexed-spans",
      "bit": 1
    },
    {
      "name": "projected-indexed-spans",
      "bit": 2
    },
    {
      "name": "indexed-frame-batches",
      "bit": 3
    },
    {
      "name": "borrowed-indexed-blit",
      "bit": 4
    },
    {
      "name": "exact-indexed-blit",
      "bit": 5
    }
  ],
  "create_flags": [
    {
      "name": "prefer-direct-scanout",
      "bit": 0
    },
    {
      "name": "borrow-commands",
      "bit": 1,
      "semantics": "Submit validates and rasterizes borrowed bytes synchronously. Never retains the input pointer. WOULD_BLOCK consumes no frame ID; retry after framebuffer progress. Host may reject unsupported mode at creation. Display remains asynchronous."
    }
  ],
