{
  "schema": "pxa-ui-spec-0.4",
  "status": "draft",
  "service": {
    "name": "ui",
    "id": 3,
    "major": 0,
    "minor": 4,
    "patch": 0
  },
  "byte_order": "little-endian",
  "startup_configuration": {
    "record": {
      "name": "ui-environment",
      "id": 8,
      "payload": "environment-records",
      "cardinality": "one-for-ui-component"
    },
    "rule": "the initial primary-Surface environment is authoritative; later changes use environment-changed"
  },
  "features": [
    {
      "name": "grid",
      "bit": 0
    },
    {
      "name": "canvas",
      "bit": 1
    },
    {
      "name": "virtual-list",
      "bit": 2
    },
    {
      "name": "media-surface",
      "bit": 3
    },
    {
      "name": "animation",
      "bit": 4
    },
    {
      "name": "accessibility",
      "bit": 5
    },
    {
      "name": "multiple-surfaces",
      "bit": 6
    },
    {
      "name": "shared-command-buffer",
      "bit": 7
    },
    {
      "name": "rgb565-bitmap",
      "bit": 8
    },
    {
      "name": "controller-input",
      "bit": 9
    },
    {
      "name": "canvas-stream-io",
      "bit": 10
    }
  ],
  "opcodes": [
    {
      "name": "tx-begin",
      "id": 1,
      "direction": "guest-to-host",
      "payload": "surface:u32|transaction:u32|generation:u32|target:u32|kind:u8|flags:u8|reserved:u16"
    },
    {
      "name": "tx-write",
      "id": 2,
      "direction": "guest-to-host",
      "payload": "transaction:u32|command-stream-fragment"
    },
    {
      "name": "tx-commit",
      "id": 3,
      "direction": "guest-to-host",
      "payload": "transaction:u32"
    },
    {
      "name": "tx-cancel",
      "id": 4,
      "direction": "guest-to-host",
      "payload": "transaction:u32"
    },
    {
      "name": "surface-open",
      "id": 5,
      "direction": "guest-to-host",
      "payload": "request:u32|role:u8|flags:u8|reserved:u16"
    },
    {
      "name": "surface-close",
      "id": 6,
      "direction": "guest-to-host",
      "payload": "surface:u32"
    },
    {
      "name": "canvas-begin",
      "id": 7,
      "direction": "guest-to-host",
      "payload": "surface:u32|node:u32|frame:u32|flags:u32"
    },
    {
      "name": "canvas-write",
      "id": 8,
      "direction": "guest-to-host",
      "payload": "surface:u32|node:u32|frame:u32|display-list-fragment"
    },
    {
      "name": "canvas-present",
      "id": 9,
      "direction": "guest-to-host",
      "payload": "surface:u32|node:u32|frame:u32|dirty-count:u8|dirty-rects:i32[4]"
    },
    {
      "name": "canvas-stream-open",
      "id": 10,
      "direction": "guest-to-host",
      "payload": "request:u32|surface:u32|node:u32"
    },
    {
      "name": "theme-get",
      "id": 11,
      "direction": "guest-to-host",
      "payload": "empty; nonzero envelope request-id; reply status:i32 followed by theme-snapshot"
    },
    {
      "name": "event",
      "id": 32769,
      "direction": "host-to-guest",
      "payload": "surface:u32|node:u32|generation:u32|kind:u16|flags:u16|timestamp-us:u64|value"
    },
    {
      "name": "environment-changed",
      "id": 32770,
      "direction": "host-to-guest",
      "payload": "environment-records"
    },
    {
      "name": "resource-pressure",
      "id": 32771,
      "direction": "host-to-guest",
      "payload": "level:u8|reserved:u8[3]"
    },
    {
      "name": "surface-ready",
      "id": 32772,
      "direction": "host-to-guest",
      "payload": "request:u32|surface:u32|status:i32|environment-records"
    },
    {
      "name": "canvas-stream-ready",
      "id": 32773,
      "direction": "host-to-guest",
      "payload": "request:u32|handle:u32|status:i32"
    },
    {
      "name": "theme-changed",
      "id": 32774,
      "direction": "host-to-guest",
      "payload": "theme-snapshot; unsolicited request-id zero"
    }
  ],
  "theme_snapshot": {
    "size": 60,
    "payload": "generation:u32|color-scheme:u8 (0 light, 1 dark)|reserved:u8[3]|rgba:u32[10]|typography-px:u16[6]",
    "rgba_encoding": "0xRRGGBBAA; background,surface,primary,on-primary,text,muted,border,success,warning,danger",
    "typography_order": "caption,label,body,title,headline,display",
    "rule": "Host increments generation on scheme or palette changes; bound UI guests receive theme-changed and should repaint theme-token content"
  },
  "transactions": {
    "primary_surface": 1,
    "kinds": [
      {
        "name": "patch",
        "value": 1
      },
      {
        "name": "replace-subtree",
        "value": 2
      },
      {
        "name": "replace-surface",
        "value": 3
      }
    ],
    "flags": [
      {
        "name": "preserve-on-failure",
        "value": 1,
        "required": true
      }
    ],
    "command_header": "command:u8|flags:u8|payload-len:u16",
    "optional_command_flag": 1,
    "fragmentation": "tx-write fragments form one byte-exact command stream; command headers and payloads may cross fragment boundaries",
    "generation": "strictly-increasing-per-surface",
    "atomic": "the previously committed tree remains active when validation, allocation, backend preparation, or commit fails"
  },
  "commands": [
    {
      "name": "create",
      "id": 1,
      "payload": "node:u32|parent:u32|before:u32|type:u8|subtype:u8|reserved:u16"
    },
    {
      "name": "set-property",
