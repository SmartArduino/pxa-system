  "value_types": {
    "length": "unit:u8|reserved:u8[3]|value:i32; units:auto=0,logical-px=1,percent-q16=2,content=3,fill=4,viewport-width-q16=5,viewport-height-q16=6",
    "color": "kind:u8|token:u8|reserved:u16|rgba8888:u32; kinds=token:0,rgba:1",
    "logical_pixel": "1/64 dp encoded as i32",
    "track_list": "kind:u8|reserved:u8[3]|value:u32; kinds=content:0,fraction:1,fixed:2; value is the fraction weight or the /64 dp size"
  },
  "canvas_display_list": {
    "record_header": "primitive:u8|flags:u8|payload-len:u16",
    "fragmentation": "canvas-write fragments form one byte-exact display list and may split headers or payloads",
    "coordinate_space": "signed logical pixels relative to the Canvas content origin",
    "rgba": "RGBA8888 with alpha in the low byte",
    "primitives": [
      {
        "name": "rect",
        "id": 1,
        "payload": "x:i32|y:i32|width:u32|height:u32|fill-rgba:u32|radius:u16|border-width:u16|border-rgba:u32"
      },
      {
        "name": "ellipse",
        "id": 2,
        "payload": "x:i32|y:i32|width:u32|height:u32|fill-rgba:u32|border-width:u16|border-rgba:u32"
      },
      {
        "name": "line",
        "id": 3,
        "payload": "x1:i32|y1:i32|x2:i32|y2:i32|rgba:u32|width:u16"
      },
      {
        "name": "arc",
        "id": 4,
        "payload": "center-x:i32|center-y:i32|radius:u32|start-angle:u16|end-angle:u16|rgba:u32|width:u16"
      },
      {
        "name": "text",
        "id": 5,
        "payload": "x:i32|y:i32|width:u32|rgba:u32|font-role:u8|align:u8|utf8:bytes"
      },
      {
        "name": "image",
        "id": 6,
        "payload": "x:i32|y:i32|width:u32|height:u32|opacity:u8|fit:u8|package-path:bytes"
      },
      {
        "name": "clip-push",
        "id": 7,
        "payload": "x:i32|y:i32|width:u32|height:u32"
      },
      {
        "name": "clip-pop",
        "id": 8,
        "payload": ""
      },
      {
        "name": "text-box",
        "id": 9,
        "payload": "x:i32|y:i32|width:u32|height:u32|rgba:u32|font-role:u8|align:u8|vertical-align:u8|reserved:u8|utf8"
      },
      {
        "name": "bitmap-rgb565",
        "id": 10,
        "feature": "rgb565-bitmap",
        "payload": "x:i32|y:i32|width:u32|height:u32|stride:u32|pixels:bytes",
        "since": "0.2",
        "rules": "width and height fit u16; stride fits u16 and is at least width*2; pixels length equals stride*height; pixels are little-endian RGB565; large frames are split into horizontal strips"
      }
    ],
    "nesting": "clip records must balance; depth is governed by the Host byte budget, not a protocol count limit",
    "lifetime": "a successful present transfers list ownership to the backend; failure preserves the previous frame"
  },
