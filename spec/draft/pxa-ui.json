  },
  "controller_input": {
    "event-kind": "controller-state=10",
    "event-payload": "controller:u8|connected:u8|reserved:u16|buttons:u32",
    "buttons": {
      "up": 0,
      "down": 1,
      "left": 2,
      "right": 3,
      "a": 4,
      "b": 5,
      "start": 6,
      "select": 7
    },
    "policy": "each coalescible event is a complete state; disconnected state has zero buttons"
  },
  "event_flags": [
