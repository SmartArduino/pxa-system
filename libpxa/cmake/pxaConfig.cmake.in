@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/pxaTargets.cmake")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/pxaAdaptersTargets.cmake")
    include(CMakeFindDependencyMacro)
    find_dependency(OpenSSL)
    find_dependency(Threads)
    if(@JPEG_FOUND@)
        find_dependency(JPEG)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/pxaAdaptersTargets.cmake")
endif()
check_required_components(pxa)
