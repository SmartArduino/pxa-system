+        aot_annotate_memory_bound(comp_ctx,
+                                  func_ctx->mem_info[0].mem_bound_check_4bytes, 4);
+        aot_annotate_memory_bound(comp_ctx,
+                                  func_ctx->mem_info[0].mem_bound_check_8bytes, 8);
+        aot_annotate_memory_bound(comp_ctx,
+                                  func_ctx->mem_info[0].mem_bound_check_16bytes, 16);
+    }
+
     return true;
 }
 
