+#include "aot_emit_memory.h"
 #include "aot_emit_table.h"
 #include "../aot/aot_runtime.h"
 #include "../aot/aot_intrinsic.h"
@@ -1525,6 +1526,19 @@ create_memory_info(const AOTCompContext *comp_ctx, AOTFuncContext *func_ctx,
         }
     }
 
+    if (mem_space_unchanged) {
+        aot_annotate_memory_bound(comp_ctx,
+                                  func_ctx->mem_info[0].mem_bound_check_1byte, 1);
+        aot_annotate_memory_bound(comp_ctx,
