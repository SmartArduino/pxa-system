diff --git a/core/iwasm/compilation/aot_emit_memory.c b/core/iwasm/compilation/aot_emit_memory.c
index 0e82f6de..6c37275a 100644
--- a/core/iwasm/compilation/aot_emit_memory.c
+++ b/core/iwasm/compilation/aot_emit_memory.c
@@ -11,6 +11,38 @@
 #include "aot_emit_control.h"
 #include "bh_safe_arith.h"
 
+/* The instantiated memory cannot be smaller than the module's initial
+ * memory, and memory.grow never shrinks it. Express this existing runtime
+ * contract on bound loads so LLVM can prove static array accesses safe.
+ * This does not declare arbitrary guest addresses to be in bounds. */
+void
+aot_annotate_memory_bound(AOTCompContext *comp_ctx, LLVMValueRef instruction,
+                           uint32 bytes)
+{
+    WASMModule *module = comp_ctx->comp_data->wasm_module;
+    uint64 initial_bytes;
+    LLVMMetadataRef limits[2], range;
+    LLVMTypeRef type;
+    if (!comp_ctx->enable_bound_check || !LLVMIsALoadInst(instruction)
+        || module->import_memory_count != 0 || module->memory_count != 1
+        || (comp_ctx->comp_data->memories[0].flags
+            & (SHARED_MEMORY_FLAG | MEMORY64_FLAG)))
+        return;
+    initial_bytes =
+        (uint64)comp_ctx->comp_data->memories[0].num_bytes_per_page
+        * comp_ctx->comp_data->memories[0].init_page_count;
+    if (initial_bytes <= bytes || initial_bytes > (UINT64_C(1) << 32))
+        return;
+    type = LLVMTypeOf(instruction);
+    limits[0] = LLVMValueAsMetadata(
+        LLVMConstInt(type, initial_bytes - bytes, false));
+    limits[1] = LLVMValueAsMetadata(LLVMConstInt(type, 0, false));
+    range = LLVMMDNodeInContext2(comp_ctx->context, limits, 2);
+    LLVMSetMetadata(instruction,
+                    LLVMGetMDKindIDInContext(comp_ctx->context, "range", 5),
+                    LLVMMetadataAsValue(comp_ctx->context, range));
+}
+
 /* A valid guest access cannot overwrite its runtime memory descriptor.
  * Keep all guest scalar types in one alias class so Wasm type punning remains
  * legal. Unknown calls still clobber both classes, including memory.grow.
@@ -157,6 +189,7 @@ get_memory_check_bound(AOTCompContext *comp_ctx, AOTFuncContext *func_ctx,
         return NULL;
     }
     set_memory_alias(comp_ctx, mem_check_bound, false);
+    aot_annotate_memory_bound(comp_ctx, mem_check_bound, bytes);
     return mem_check_bound;
 }
 
