@@ -294,6 +295,24 @@
 
     memset(mem, 0, (uint32)size);
     return mem;
+}
+
+/* Relocation arrays die before loading returns. When a pinned mapping has
+ * been reserved, borrow its not-yet-initialized bytes instead of increasing
+ * the peak permanent heap. Validation and relocation order are unchanged. */
+static void *
+loader_malloc_temporary(uint64 size, char *error_buf, uint32 error_buf_size)
+{
+    void *memory = size < UINT32_MAX
+                       ? pxa_wamr_aot_temporary_allocate((size_t)size)
+                       : NULL;
+    return memory ? memory : loader_malloc(size, error_buf, error_buf_size);
+}
+
+static void
+loader_free_temporary(void *memory)
+{
+    if (!pxa_wamr_aot_temporary_release(memory)) wasm_runtime_free(memory);
 }
 
