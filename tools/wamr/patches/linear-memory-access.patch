         if (!(res = LLVMBuildIsNotNull(comp_ctx->builder, value, name))) { \
@@ -122,6 +155,7 @@ get_memory_check_bound(AOTCompContext *comp_ctx, AOTFuncContext *func_ctx,
         aot_set_last_error("llvm build load failed.");
         return NULL;
     }
+    set_memory_alias(comp_ctx, mem_check_bound, false);
     return mem_check_bound;
 }
 
