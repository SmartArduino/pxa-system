+    /* For memory32, an immediate offset inside the initial memory admits a
+     * single unsigned bound test: addr <= (size - bytes) - offset. Since
+     * memories never shrink, the subtraction cannot underflow. This also
+     * proves addr + offset cannot overflow, preserving both protections.
+     * Keep all other memory models and shared-heap addressing unchanged. */
+    if (!is_memory64 && comp_ctx->enable_bound_check && !enable_segue
+        && offset > 0 && (uint64)offset <= UINT32_MAX
+        && comp_ctx->comp_data->wasm_module->import_memory_count == 0
+        && comp_ctx->comp_data->wasm_module->memory_count == 1
+        && (uint64)offset + bytes
+               <= (uint64)comp_ctx->comp_data->memories[0].num_bytes_per_page
+                      * comp_ctx->comp_data->memories[0].init_page_count
+#if WASM_ENABLE_SHARED_MEMORY != 0
+        && !is_shared_memory
+#endif
+#if WASM_ENABLE_SHARED_HEAP != 0
+        && !comp_ctx->enable_shared_heap && !comp_ctx->enable_shared_chain
+#endif
+    ) {
+        LLVMValueRef limit;
+        if (!(mem_check_bound = get_memory_check_bound(comp_ctx, func_ctx,
+                                                       bytes)))
+            goto fail;
+        BUILD_OP(Sub, mem_check_bound, offset_const, limit, "address_limit");
+        BUILD_ICMP(LLVMIntUGT, addr, limit, cmp, "address_out_of_bounds");
+        ADD_BASIC_BLOCK(check_succ, "check_effective_address_succ");
+        LLVMMoveBasicBlockAfter(check_succ, block_curr);
+        if (!aot_emit_exception(comp_ctx, func_ctx,
+                                EXCE_OUT_OF_BOUNDS_MEMORY_ACCESS, true, cmp,
+                                check_succ))
+            goto fail;
+        SET_BUILD_POS(check_succ);
+        BUILD_OP(Add, offset_const, addr, offset1, "effective_offset");
+        if (!(maddr = LLVMBuildInBoundsGEP2(comp_ctx->builder, INT8_TYPE,
+                                            mem_base_addr, &offset1, 1,
+                                            "maddr")))
+            goto fail;
+        if (is_local_of_aot_value
+            && !aot_checked_addr_list_add(func_ctx, local_idx_of_aot_value,
+                                           offset, bytes))
+            goto fail;
+        return maddr;
+    }
+
     /* offset1 = offset + addr; */
     BUILD_OP(Add, offset_const, addr, offset1, "offset1");
 
