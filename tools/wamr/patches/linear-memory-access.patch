+/* A valid guest access cannot overwrite its runtime memory descriptor.
+ * Keep all guest scalar types in one alias class so Wasm type punning remains
+ * legal. Unknown calls still clobber both classes, including memory.grow.
+ * Leave imported/multiple/shared memories on the existing conservative path.
+ */
+static void
+set_memory_alias(AOTCompContext *comp_ctx, LLVMValueRef instruction,
+                 bool guest)
+{
+    LLVMContextRef ctx = comp_ctx->context;
+    WASMModule *module = comp_ctx->comp_data->wasm_module;
+    LLVMMetadataRef root, type, tag, operands[3];
+    const char *name = guest ? "WAMR linear bytes" : "WAMR memory descriptor";
+    if (module->import_memory_count != 0 || module->memory_count != 1)
+        return;
+#if WASM_ENABLE_SHARED_MEMORY != 0
+    if (comp_ctx->comp_data->memories[0].flags & SHARED_MEMORY_FLAG)
+        return;
+#endif
+    operands[0] = LLVMMDStringInContext2(ctx, "WAMR memory regions", 19);
+    root = LLVMMDNodeInContext2(ctx, operands, 1);
+    operands[0] = LLVMMDStringInContext2(ctx, name, strlen(name));
+    operands[1] = root;
+    type = LLVMMDNodeInContext2(ctx, operands, 2);
+    operands[0] = type;
+    operands[1] = type;
+    operands[2] = LLVMValueAsMetadata(
+        LLVMConstInt(LLVMInt64TypeInContext(ctx), 0, false));
+    tag = LLVMMDNodeInContext2(ctx, operands, 3);
+    LLVMSetMetadata(instruction, LLVMGetMDKindIDInContext(ctx, "tbaa", 4),
+                    LLVMMetadataAsValue(ctx, tag));
+}
