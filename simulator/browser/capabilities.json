{
  "version": "0.6.0",
  "target": "browser",
  "engine": "webassembly",
  "core": "pxa.core.v2",
  "services": {
    "ui": {
      "backend": "LVGL",
      "nativeFonts": "OffscreenCanvas",
      "textInput": "DOM composition",
      "pointerContacts": 1,
      "packageImages": {
        "format": "PNG",
        "maxBytes": 1048576,
        "maxDimension": 1024,
        "assetHandles": true
      }
    },
    "window": {
      "back": true,
      "focus": true,
      "toast": true,
      "systemChrome": false
    },
    "clock": {
      "monotonic": true,
      "wall": true,
      "foregroundTimers": true
    },
    "storage": {
      "backend": "IndexedDB",
      "quotaBytes": 262144,
      "requires": [
        "indexedDB",
        "navigator.locks"
      ]
    },
    "fs": {
      "backend": "private MEMFS + IDBFS",
      "quotaBytes": 268435456,
      "externalFiles": true,
      "appMediaRoot": true
    },
    "audio": {
      "backend": "AudioWorklet + PXA mixer",
      "pcm": true,
      "tone": true,
      "effects": true,
      "mix": true,
      "psg": true,
      "assetPlayback": true,
      "systemMasterVolumeControl": false,
      "residentSound": true,
      "capture": "native microphone with explicit consent; raw Opus via WebCodecs"
    },
    "net": {
      "backend": "Fetch + authenticated public HTTP/TLS relay",
      "credentials": "omit",
      "redirects": "error",
      "permission": "signed exact origin or web; outbound sockets on public ports 80/443",
      "httpOpenRequires": "streaming request support only for streaming uploads",
      "maxBufferBytes": 65536,
      "connectivity": "browser link state",
      "sockets": "bounded authenticated relay"
    },
    "surface": {
      "formats": [
        "RGB565",
        "ARGB8888_PREMULTIPLIED"
      ],
      "guestMapped": true,
      "opaqueUiRegions": false,
      "mapping": "pinned Host shadow, submitted bank copy"
    },
    "gameRender": {
      "raster": true,
      "indexedBlit": true,
      "priorityTiles": true
    },
    "device": {
      "runtimeInfo": true,
      "hardwareMac": false
    },
    "log": {
      "backend": "bounded page log"
    },
    "permission": {
      "declarations": [
        "audio.playback",
        "audio.capture",
        "net.client",
        "net.socket"
      ]
    },
    "ipc": {
      "scope": "one isolated application",
      "externalPeers": false
    },
    "assets": {
      "backend": "shared PXA cache and loaders",
      "imageDecode": true,
      "png": true,
      "jpeg": true,
      "gifFrames": true,
      "resourcePacks": true
    },
    "sensor": {
      "physicalSensors": false,
      "enumeration": true
    }
  },
  "unavailableServices": [
    "work",
    "imeProvider",
    "storeInstaller"
  ],
  "limits": {
    "controlBytes": 4096,
    "ioBytes": 4194304,
    "hostMemoryBytes": 536870912,
    "borrowMirrorBytes": 67108864,
    "guestMemoryBytes": 536870912
  },
  "packageLoader": "reviewed store Wasm modules",
  "aot": false,
  "compatibility": {
    "core": [
      2,
      1
    ],
    "maxWasmBytes": 16777216,
    "maxGuestBytes": 536870912,
    "services": [
      {
        "service_id": 1,
        "major": 2,
        "minor": 2,
        "features": 0
      },
      {
        "service_id": 2,
        "major": 0,
        "minor": 4,
        "features": 0
      },
      {
        "service_id": 3,
        "major": 0,
        "minor": 9,
        "features": 32583
      },
      {
        "service_id": 4,
        "major": 0,
        "minor": 3,
        "features": 1
      },
      {
        "service_id": 5,
        "major": 0,
        "minor": 5,
        "features": 451
      },
      {
        "service_id": 6,
        "major": 0,
        "minor": 1,
        "features": 0
      },
      {
        "service_id": 7,
        "major": 0,
        "minor": 1,
        "features": 0
      },
      {
        "service_id": 9,
        "major": 0,
        "minor": 6,
        "features": 0
      },
      {
        "service_id": 10,
        "major": 0,
        "minor": 15,
        "features": 0
      },
      {
        "service_id": 11,
        "major": 0,
        "minor": 1,
        "features": 0
      },
      {
        "service_id": 14,
        "major": 0,
        "minor": 1,
        "features": 63
      },
      {
        "service_id": 15,
        "major": 0,
        "minor": 2,
        "features": 0
      },
      {
        "service_id": 16,
        "major": 0,
        "minor": 2,
        "features": 0
      },
      {
        "service_id": 18,
        "major": 1,
        "minor": 5,
        "features": 113
      },
      {
        "service_id": 19,
        "major": 0,
        "minor": 1,
        "features": 0
      },
      {
        "service_id": 8,
        "major": 0,
        "minor": 1,
        "features": 0
      },
      {
        "service_id": 21,
        "major": 2,
        "minor": 6,
        "features": 7
      }
    ],
    "resourcePacks": true,
    "permissions": [
      "audio.playback",
      "audio.capture",
      "net.client",
      "net.socket"
    ],
    "primaryUiEntry": true
  },
  "mainLoop": {
    "backend": "WebAssembly JSPI",
    "requires": [
      "WebAssembly.Suspending",
      "WebAssembly.promising"
    ]
  }
}
