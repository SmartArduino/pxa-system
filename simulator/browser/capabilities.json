{
  "version": "0.2.0",
  "target": "browser",
  "engine": "webassembly",
  "core": "pxa.core.v2",
  "services": {
    "ui": {"backend": "LVGL", "nativeFonts": "OffscreenCanvas", "textInput": "DOM composition", "pointerContacts": 1},
    "window": {"back": true, "focus": true, "toast": true, "systemChrome": false},
    "clock": {"monotonic": true, "wall": true, "foregroundTimers": true},
    "storage": {"backend": "IndexedDB", "quotaBytes": 262144, "requires": ["indexedDB", "navigator.locks"]},
    "fs": {"backend": "private MEMFS + IDBFS", "quotaBytes": 8388608, "externalFiles": false},
    "audio": {"backend": "AudioWorklet + PXA mixer", "pcm": true, "tone": true, "effects": true, "mix": true, "psg": true, "gbPsg": true, "assetPlayback": false, "systemMasterVolumeControl": false},
    "net": {"backend": "Fetch", "credentials": "omit", "redirects": "error", "permission": "exact origin", "httpOpenRequires": "streaming request support", "maxBufferBytes": 65536},
    "surface": {"formats": ["RGB565", "ARGB8888_PREMULTIPLIED"], "guestMapped": false, "opaqueUiRegions": false},
    "gameRender": {"raster": true, "indexedSpans": true, "projectedSpans": true, "frameSpans": true, "indexedBlit": true, "priorityTiles": true},
    "device": {"runtimeInfo": true, "hardwareMac": false},
    "log": {"backend": "bounded page log"},
    "permission": {"declarations": ["audio.playback", "net.client"]},
    "ipc": {"scope": "one isolated application", "externalPeers": false}
  },
  "unavailableServices": ["assets", "sensor", "lease", "work", "imeProvider", "storeInstaller"],
  "limits": {"controlBytes": 4096, "ioBytes": 4194304, "hostMemoryBytes": 134217728, "borrowMirrorBytes": 67108864},
  "packageLoader": "curated Wasm modules",
  "aot": false
}
