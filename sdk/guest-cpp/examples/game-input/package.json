{
  "format": "pxa-package-source-0.1",
  "min_sdk": [2, 0],
  "target_sdk": [2, 0],
  "compile_sdk": [2, 0],
  "id": "pxa-cpp-game-input",
  "version": "1.0.0",
  "name": "C++ Game Input",
  "description": "Pure GameRender with application controller and pointer callbacks",
  "build": {"system": "cmake", "source_dir": "."},
  "components": [{
    "id": "main",
    "kind": "ui",
    "services": ["ui", "clock", "game-render"],
    "cmake_target": "pxa_main",
    "wasi": {"version": "preview1", "libc": "wasi-libc", "features": ["monotonic-clock", "wall-clock"]}
  }]
}
