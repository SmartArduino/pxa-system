{
  "format": "pxa-package-source-0.1",
  "min_sdk": [1, 0],
  "target_sdk": [1, 0],
  "compile_sdk": [1, 0],
  "id": "pxa-cpp-audio",
  "version": "1.0.0",
  "name": "C++ Audio",
  "description": "Permission and Audio session example",
  "build": {"system": "cmake", "source_dir": "."},
  "permissions": [{"name": "audio.playback", "scope": "media", "required": false}],
  "components": [{
    "id": "main",
    "kind": "ui",
    "services": ["ui", "audio"],
    "cmake_target": "pxa_main",
    "wasi": {"version": "preview1", "libc": "wasi-libc", "features": ["monotonic-clock", "wall-clock"]}
  }]
}
