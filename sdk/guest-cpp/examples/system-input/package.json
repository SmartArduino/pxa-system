{
  "format": "pxa-package-source-0.1",
  "min_sdk": [1, 0], "target_sdk": [1, 0], "compile_sdk": [1, 0],
  "id": "pxa-cpp-system-input", "version": "1.0.0",
  "name": "系统输入法示例",
  "description": "C++ TextInputRef with system IME and system theme",
  "build": {"system": "cmake", "source_dir": "."},
  "components": [{
    "id": "main", "kind": "ui", "cmake_target": "pxa_main",
    "services": [{"name": "ui", "features": ["text-input-control"]}, "log"],
    "wasi": {"version": "preview1", "libc": "wasi-libc",
             "features": ["monotonic-clock", "wall-clock"]}
  }]
}
