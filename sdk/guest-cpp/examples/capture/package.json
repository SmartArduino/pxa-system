{
  "format": "pxa-package-source-0.1",
  "id": "pxa-cpp-capture",
  "version": "1.0.1",
  "release_sequence": 2,
  "name": "Microphone capture",
  "description": "Permission-controlled standard Audio capture with bounded local Opus packet storage.",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 1048576,
      "pinned": true
    }
  },
  "permissions": [
    {
      "name": "audio.capture",
      "scope": "microphone",
      "required": false
    }
  ],
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "services": [
        "ui",
        "audio",
        "permission",
        "clock",
        "fs",
        "log",
        "window"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ]
}
